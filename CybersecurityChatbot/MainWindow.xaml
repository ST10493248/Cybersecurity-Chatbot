<Window x:Class="CyberSecurityChatbot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Awareness Assistant"
        Height="700"
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize">

    <Window.Resources>
        <!-- Topic Button Style with GLOWING HOVER EFFECT -->
        <Style x:Key="TopicButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                BorderBrush="#89B4FA"
                                BorderThickness="0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#2A2A3E" Offset="0"/>
                                                        <GradientStop Color="#1E1E2E" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#89B4FA" 
                                                                      BlurRadius="12" 
                                                                      ShadowDepth="0" 
                                                                      Opacity="0.7"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ContentPresenter x:Name="content"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Margin="12,8"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="content" Property="TextElement.Foreground" Value="#89B4FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Send Button Style -->
        <Style x:Key="SendButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#89B4FA"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#89B4FA" 
                                                                      BlurRadius="15" 
                                                                      ShadowDepth="0" 
                                                                      Opacity="0.8"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#A9D4FF" Offset="0"/>
                                                        <GradientStop Color="#89B4FA" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Suggestion Chip Style -->
        <Style x:Key="SuggestionChipStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,0,14,0"/>
            <Setter Property="Margin" Value="0,5,10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="16">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#89B4FA"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#89B4FA" 
                                                                      BlurRadius="10" 
                                                                      ShadowDepth="0" 
                                                                      Opacity="0.6"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="TextElement.Foreground" Value="#1E1E2E"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>

        <!-- SIDEBAR -->
        <Border Background="#181825"
                Width="280"
                HorizontalAlignment="Left">

            <StackPanel Margin="20">

                <!-- TITLE with Glow on Hover -->
                <TextBlock Text="Awareness Assistant"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#89B4FA"
                           Margin="0,10,0,5">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#89B4FA" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Border Height="1" 
                        Background="#313244" 
                        Margin="0,15,0,20"/>

                <!-- TOPICS HEADER -->
                <TextBlock Text="TOPICS"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="#6C7086"
                           Margin="0,0,0,10"/>

                <!-- TOPICS BUTTONS WITH GLOW -->
                <Button x:Name="btnPhishing"
                        Content="Phishing"
                        Style="{StaticResource TopicButtonStyle}"/>

                <Button x:Name="btnPasswords"
                        Content="Passwords"
                        Style="{StaticResource TopicButtonStyle}"/>

                <Button x:Name="btnPrivacy"
                        Content="Privacy"
                        Style="{StaticResource TopicButtonStyle}"/>

                <Button x:Name="btnScams"
                        Content="Scams"
                        Style="{StaticResource TopicButtonStyle}"/>

                <Button x:Name="btnSafeBrowsing"
                        Content="Safe browsing"
                        Style="{StaticResource TopicButtonStyle}"/>

                <Border Height="1" 
                        Background="#313244" 
                        Margin="0,25,0,20"/>

                <!-- MEMORY SECTION -->
                <TextBlock Text="MEMORY"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="#6C7086"
                           Margin="0,0,0,10"/>

                <Border Background="#1E1E2E"
                        CornerRadius="6"
                        Padding="12,10"
                        BorderBrush="#313244"
                        BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="#89B4FA"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#89B4FA" BlurRadius="6" ShadowDepth="0" Opacity="0.3"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel>
                        <TextBlock Text="STORED DETAILS"
                                   FontSize="10"
                                   Foreground="#6C7086"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="Name:"
                                   FontSize="11"
                                   Foreground="#7F849C"/>

                        <TextBlock x:Name="txtStoredName"
                                   Text="Not set"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#89B4FA"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="Topic:"
                                   FontSize="11"
                                   Foreground="#7F849C"/>

                        <TextBlock x:Name="txtStoredTopic"
                                   Text="None"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#89B4FA"/>
                    </StackPanel>
                </Border>

                <!-- STATISTICS SECTION -->
                <Border Background="#1E1E2E"
                        CornerRadius="6"
                        Padding="12,10"
                        Margin="0,15,0,0"
                        BorderBrush="#313244"
                        BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="#89B4FA"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#89B4FA" BlurRadius="6" ShadowDepth="0" Opacity="0.3"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel>
                        <TextBlock Text="STATISTICS"
                                   FontSize="10"
                                   Foreground="#6C7086"
                                   Margin="0,0,0,6"/>
                        <TextBlock x:Name="txtTipsGiven"
                                   Text="💡 Tips given: 0"
                                   FontSize="11"
                                   Foreground="#89B4FA"/>
                        <TextBlock x:Name="txtSessionTime"
                                   Text="⏱️ Session: 0 min"
                                   FontSize="11"
                                   Foreground="#89B4FA"/>
                        <TextBlock x:Name="txtMood"
                                   Text="😊 Mood: Neutral"
                                   FontSize="11"
                                   Foreground="#89B4FA"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- MAIN CHAT CONTENT -->
        <Grid Margin="300,15,15,15">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- CHAT HEADER -->
            <Border Grid.Row="0"
                    Background="#181825"
                    CornerRadius="6"
                    Padding="15,10"
                    Margin="0,0,0,10"
                    BorderBrush="#313244"
                    BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#89B4FA"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#89B4FA" BlurRadius="6" ShadowDepth="0" Opacity="0.3"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                    </Style>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <TextBlock Text="Chat"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#89B4FA"/>
                    <TextBlock x:Name="txtChatTimestamp"
                               Text=""
                               FontSize="11"
                               Foreground="#6C7086"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- CHAT DISPLAY AREA -->
            <Border Grid.Row="1"
                    Background="#1E1E2E"
                    CornerRadius="6"
                    BorderBrush="#313244"
                    BorderThickness="1"
                    Margin="0,0,0,10">

                <RichTextBox x:Name="rtbChat"
                             Background="#1E1E2E"
                             Foreground="#CDD6F4"
                             BorderThickness="0"
                             FontSize="13"
                             Padding="15"
                             IsReadOnly="True">
                    <RichTextBox.Resources>
                        <Style TargetType="{x:Type Paragraph}">
                            <Setter Property="Margin" Value="0,0,0,12"/>
                        </Style>
                    </RichTextBox.Resources>
                </RichTextBox>
            </Border>

            <!-- SUGGESTION CHIPS -->
            <WrapPanel Grid.Row="2"
                       Margin="0,5,0,15"
                       x:Name="suggestionPanel">

                <Button Content="🎣 Phishing tips"
                        Style="{StaticResource SuggestionChipStyle}"
                        Click="SuggestionChip_Click"
                        Tag="phishing tips"/>

                <Button Content="🔐 Password safety"
                        Style="{StaticResource SuggestionChipStyle}"
                        Click="SuggestionChip_Click"
                        Tag="password safety"/>

                <Button Content="❓ What can you do?"
                        Style="{StaticResource SuggestionChipStyle}"
                        Click="SuggestionChip_Click"
                        Tag="help"/>

                <Button Content="💡 Random tip"
                        Style="{StaticResource SuggestionChipStyle}"
                        Click="SuggestionChip_Click"
                        Tag="random tip"/>

                <Button Content="📊 Stats"
                        Style="{StaticResource SuggestionChipStyle}"
                        Click="SuggestionChip_Click"
                        Tag="stats"/>

                <Button Content="🎓 Fun fact"
                        Style="{StaticResource SuggestionChipStyle}"
                        Click="SuggestionChip_Click"
                        Tag="fun fact"/>
            </WrapPanel>

            <!-- INPUT AREA -->
            <Border Grid.Row="3"
                    Background="#181825"
                    CornerRadius="6"
                    Padding="10"
                    BorderBrush="#313244"
                    BorderThickness="1"
                    Height="55">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="txtInput"
                             Height="32"
                             FontSize="12"
                             Background="#1E1E2E"
                             Foreground="#CDD6F4"
                             BorderBrush="#313244"
                             BorderThickness="1"
                             Padding="10,0,10,0"
                             CaretBrush="#89B4FA"
                             VerticalContentAlignment="Center"/>

                    <Button x:Name="btnSend"
                            Grid.Column="1"
                            Content="Send"
                            Margin="8,0,0,0"
                            Style="{StaticResource SendButtonStyle}"/>
                </Grid>
            </Border>

        </Grid>

    </Grid>
</Window>